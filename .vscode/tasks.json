{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start local website",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/preview.cjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "local-preview",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local preview ready:.*"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    }
  ]
}
